<UserControl x:Class="HLab.Erp.Core.Avalonia.Views.DetailView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:HLab.Icons.Avalonia.Icons;assembly=HLab.Icons.Avalonia"
             xmlns:lang="clr-namespace:HLab.Localization.Avalonia.Lang;assembly=HLab.Localization.Avalonia"
             xmlns:controls="clr-namespace:HLab.Base.Avalonia.Controls;assembly=HLab.Base.Avalonia"
             xmlns:entitySelectors="clr-namespace:HLab.Erp.Core.Avalonia.EntitySelectors"
             xmlns:views="clr-namespace:HLab.Erp.Core.Avalonia.Views"
             >
    <UserControl.Styles>
        <Style Selector="Label">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{DynamicResource HLab.Brushes.Foreground}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="lang|LocalizedLabel">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{DynamicResource HLab.Brushes.Foreground}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Équivalents des Separator/SmallSeparator WPF. IMPORTANT : un Label
             (pas un Border — le PropertyGrid n'avance pas son curseur sur les
             Border, la ligne suivante se superposerait). -->
        <Style Selector="Label.separator">
            <Setter Property="FontStyle" Value="Normal"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,15,0,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource HLab.Brushes.Badge.Foreground}"/>
            <Setter Property="Background" Value="{DynamicResource HLab.Brushes.Accent3}"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="Label.small-separator">
            <Setter Property="FontStyle" Value="Normal"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <!-- Équivalent des styles implicites du DetailView WPF : hors édition les
             champs sont en lecture seule. Syntaxe Avalonia : $parent[Type].Prop
             (le markup RelativeSource FindAncestor ne s'applique pas en setter). -->
        <Style Selector="controls|PropertyGrid TextBox">
            <Setter Property="IsReadOnly" Value="{Binding !$parent[views:DetailView].EditMode}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>
        <Style Selector="controls|PropertyGrid NumericUpDown">
            <Setter Property="IsReadOnly" Value="{Binding !$parent[views:DetailView].EditMode}"/>
        </Style>
        <Style Selector="controls|PropertyGrid CheckBox">
            <Setter Property="IsEnabled" Value="{Binding $parent[views:DetailView].EditMode}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>
        <Style Selector="controls|PropertyGrid CalendarDatePicker">
            <Setter Property="IsEnabled" Value="{Binding $parent[views:DetailView].EditMode}"/>
        </Style>
        <Style Selector="controls|PropertyGrid entitySelectors|ForeignView">
            <Setter Property="IsReadOnly" Value="{Binding !$parent[views:DetailView].EditMode}"/>
        </Style>
    </UserControl.Styles>

    <!-- Content explicite obligatoire : Children étant [Content], le contenu
         implicite de ce fichier serait routé vers PART_Host (null pendant l'init). -->
    <UserControl.Content>
    <Grid RowDefinitions="Auto,*,10">

        <!-- Parité WPF (style Separator) : blanc sur bande accent translucide —
             Header.Background/Foreground donnait du gris sur gris. -->
        <Border Grid.Row="0"
                Margin="0,15,0,10"
                Background="{DynamicResource HLab.Brushes.Accent3}">
            <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
                <Canvas>
                    <icons:IconView x:Name="HeaderIcon" Height="35" Opacity="0.8"/>
                </Canvas>
                <lang:Localize x:Name="HeaderText" FontWeight="Bold" FontSize="16" Margin="50,0,0,0"
                               Foreground="{DynamicResource HLab.Brushes.Badge.Foreground}"/>
            </StackPanel>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,5,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <controls:PropertyGrid x:Name="PART_Host" ColumnDefinitions="Auto,*"/>
        </ScrollViewer>
    </Grid>
    </UserControl.Content>
</UserControl>
