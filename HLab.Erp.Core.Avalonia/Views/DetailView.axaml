<UserControl x:Class="HLab.Erp.Core.Avalonia.Views.DetailView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:HLab.Icons.Avalonia.Icons;assembly=HLab.Icons.Avalonia"
             xmlns:lang="clr-namespace:HLab.Localization.Avalonia.Lang;assembly=HLab.Localization.Avalonia"
             xmlns:controls="clr-namespace:HLab.Base.Avalonia.Controls;assembly=HLab.Base.Avalonia"
             xmlns:views="clr-namespace:HLab.Erp.Core.Avalonia.Views"
             >
    <UserControl.Styles>
        <Style Selector="Label">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{DynamicResource HLab.Brushes.Foreground}"/>
            <Setter Property="VerticalContentAlignment" Value="Bottom"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="lang|LocalizedLabel">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{DynamicResource HLab.Brushes.Foreground}"/>
            <Setter Property="VerticalContentAlignment" Value="Bottom"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="controls|PropertyGrid > TextBox">
            <Setter Property="IsReadOnly" Value="{Binding !EditMode, RelativeSource={RelativeSource FindAncestor, AncestorType=views:DetailView}}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>
        <Style Selector="controls|PropertyGrid > CheckBox">
            <Setter Property="IsEnabled" Value="{Binding EditMode, RelativeSource={RelativeSource FindAncestor, AncestorType=views:DetailView}}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>
    </UserControl.Styles>

    <!-- Content explicite obligatoire : Children étant [Content], le contenu
         implicite de ce fichier serait routé vers PART_Host (null pendant l'init). -->
    <UserControl.Content>
    <Grid RowDefinitions="Auto,*,10">

        <Border Grid.Row="0"
                Margin="0,15,0,10"
                Background="{DynamicResource HLab.Brushes.Header.Background}">
            <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
                <Canvas>
                    <icons:IconView x:Name="HeaderIcon" Height="35" Opacity="0.8"/>
                </Canvas>
                <lang:Localize x:Name="HeaderText" FontWeight="Bold" FontSize="16" Margin="50,0,0,0"
                               Foreground="{DynamicResource HLab.Brushes.Header.Foreground}"/>
            </StackPanel>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,5,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <controls:PropertyGrid x:Name="PART_Host" ColumnDefinitions="Auto,*"/>
        </ScrollViewer>
    </Grid>
    </UserControl.Content>
</UserControl>
