<UserControl x:Class="HLab.Erp.Core.Avalonia.EntityViews.EntityViewDefault"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Label Content="{Binding Caption, FallbackValue=View not found}"/>
    </Grid>
</UserControl>
