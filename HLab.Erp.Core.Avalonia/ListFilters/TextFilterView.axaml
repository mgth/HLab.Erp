<UserControl x:Class="HLab.Erp.Core.Avalonia.ListFilters.TextFilterView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Grid>
        <TextBox x:Name="TextBox" Text="{Binding Value}"/>
    </Grid>
</UserControl>
