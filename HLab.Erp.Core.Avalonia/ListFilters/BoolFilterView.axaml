<UserControl x:Class="HLab.Erp.Core.Avalonia.ListFilters.BoolFilterView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Grid>
        <CheckBox x:Name="CheckBox" IsChecked="{Binding Value}"/>
    </Grid>
</UserControl>
