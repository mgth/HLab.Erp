<UserControl x:Class="HLab.Erp.Core.Avalonia.ListFilters.EntityFilterView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Grid>
        <ContentControl x:Name="ContentControl" Content="{Binding Target}" />
    </Grid>
</UserControl>
