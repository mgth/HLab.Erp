<UserControl x:Class="HLab.Erp.Base.Avalonia.Entities.DetailSeparator"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:HLab.Localization.Avalonia.Lang;assembly=HLab.Localization.Avalonia"
             xmlns:icons="clr-namespace:HLab.Icons.Avalonia.Icons;assembly=HLab.Icons.Avalonia">
    <Border Margin="0,15,0,10" Background="{DynamicResource HLab.Brushes.Header.Background}">
        <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
            <Canvas>
                <icons:IconView x:Name="IconView" Height="35" Opacity="0.8"/>
            </Canvas>
            <lang:Localize x:Name="Localize" FontWeight="Bold" FontSize="16" Margin="50,0,0,0"
                           Foreground="{DynamicResource HLab.Brushes.Header.Foreground}"/>
        </StackPanel>
    </Border>
</UserControl>
